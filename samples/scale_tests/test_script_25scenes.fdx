  <Content>
    <Paragraph Type="Scene Heading">INT. APARTMENT - DAWN</Paragraph>
    <Paragraph Type="Action">A car speeds by outside.</Paragraph>
    <Paragraph Type="Character">MARCUS</Paragraph>
    <Paragraph Type="Dialogue">This changes everything.</Paragraph>
    <Paragraph Type="Action">EMMA paces back and forth.</Paragraph>
    <Paragraph Type="Character">EMMA</Paragraph>
    <Paragraph Type="Dialogue">I'm not sure I can help you.</Paragraph>

    <Paragraph Type="Scene Heading">INT. WAREHOUSE - EVENING</Paragraph>
    <Paragraph Type="Action">The room is dimly lit. Papers scattered everywhere.</Paragraph>
    <Paragraph Type="Character">SARAH</Paragraph>
    <Paragraph Type="Dialogue">I never wanted it to end this way.</Paragraph>
    <Paragraph Type="Character">SARAH</Paragraph>
    <Paragraph Type="Dialogue">This is bigger than both of us.</Paragraph>
    <Paragraph Type="Character">EMMA</Paragraph>
    <Paragraph Type="Dialogue">I never wanted it to end this way.</Paragraph>
    <Paragraph Type="Character">SARAH</Paragraph>
    <Paragraph Type="Parenthetical">(quietly)</Paragraph>
    <Paragraph Type="Dialogue">You don't understand the situation.</Paragraph>
    <Paragraph Type="Action">The lights flicker momentarily.</Paragraph>

    <Paragraph Type="Scene Heading">INT. SUBWAY - EVENING</Paragraph>
    <Paragraph Type="Action">Sirens wail in the distance.</Paragraph>
    <Paragraph Type="Character">THOMAS</Paragraph>
    <Paragraph Type="Dialogue">We've come too far to stop.</Paragraph>
    <Paragraph Type="Action">The lights flicker momentarily.</Paragraph>
    <Paragraph Type="Character">MARIA</Paragraph>
    <Paragraph Type="Dialogue">I'm not sure I can help you.</Paragraph>
    <Paragraph Type="Character">MARIA</Paragraph>
    <Paragraph Type="Parenthetical">(angry)</Paragraph>
    <Paragraph Type="Dialogue">You have to trust me on this.</Paragraph>
    <Paragraph Type="Action">The door slowly creaks open.</Paragraph>

