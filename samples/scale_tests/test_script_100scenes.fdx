    <Paragraph Type="Character">EMMA</Paragraph>
    <Paragraph Type="Dialogue">I never wanted it to end this way.</Paragraph>
    <Paragraph Type="Action">EMMA stares at the photograph on the wall.</Paragraph>
    <Paragraph Type="Character">EMMA</Paragraph>
    <Paragraph Type="Parenthetical">(shouting)</Paragraph>
    <Paragraph Type="Dialogue">You have to trust me on this.</Paragraph>

    <Paragraph Type="Scene Heading">EXT. PARKING LOT - EVENING</Paragraph>
