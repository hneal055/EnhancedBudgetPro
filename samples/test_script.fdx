<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<FinalDraft DocumentType="Script" Template="No" Version="1">
  <Content>
    <Paragraph Type="Scene Heading">INT. APARTMENT - NIGHT</Paragraph>
    <Paragraph Type="Action">Marcus stands over the desk. He flips through old photographs.</Paragraph>
    <Paragraph Type="Character">MARCUS</Paragraph>
    <Paragraph Type="Dialogue">I didn’t expect this to come back.</Paragraph>

    <Paragraph Type="Scene Heading">EXT. CHICAGO STREET - DAWN</Paragraph>
    <Paragraph Type="Action">Elijah runs toward the bus stop. Streets glisten from rain.</Paragraph>
    <Paragraph Type="Character">ELIJAH</Paragraph>
    <Paragraph Type="Dialogue">(whispering) Not again. Please not again.</Paragraph>

    <Paragraph Type="Scene Heading">INT. POLICE STATION - MORNING</Paragraph>
    <Paragraph Type="Action">Detective Ramirez sips burnt coffee reviewing case files.</Paragraph>
    <Paragraph Type="Character">RAMIREZ</Paragraph>
    <Paragraph Type="Dialogue">Marcus and Elijah — two names that won’t leave me alone.</Paragraph>
  </Content>
</FinalDraft>
