<?xml version="1.0" encoding="UTF-8"?>
<FinalDraft DocumentType="Script" Template="No" Version="1">
    <Content>
        <Paragraph Type="Scene Heading">
            <Text>INT. COFFEE SHOP - DAY</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>SARAH enters nervously. She spots MARK at a corner table.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>SARAH</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>I cannot believe you did this. We need to talk.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>MARK</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>I know. I have been dreading this conversation all week.</Text>
        </Paragraph>
        
        <Paragraph Type="Scene Heading">
            <Text>INT. OFFICE - DAY</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>Sarah sits alone at her desk, stressed and overwhelmed.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>SARAH</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>I cannot keep doing this alone. Everything is falling apart.</Text>
        </Paragraph>
        
        <Paragraph Type="Scene Heading">
            <Text>INT. MARK APARTMENT - NIGHT</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>Mark paces, conflicted. His phone rings. It is Sarah.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>MARK</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>Hello? Yes, I will be there. I promise this time.</Text>
        </Paragraph>
        
        <Paragraph Type="Scene Heading">
            <Text>INT. COFFEE SHOP - DAY</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>Sarah and Mark meet again. There is hope in their eyes now.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>SARAH</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>Thank you for coming. Maybe we can fix this after all.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>MARK</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>I want to try. I really do want to make this work.</Text>
        </Paragraph>
        
        <Paragraph Type="Scene Heading">
            <Text>INT. RESTAURANT - NIGHT</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>Sarah and Mark have dinner. They are smiling and laughing.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>SARAH</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>This feels right. Like we are finally moving forward.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>MARK</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>Together. That is how it should be from now on.</Text>
        </Paragraph>
        
        <Paragraph Type="Scene Heading">
            <Text>INT. SARAH APARTMENT - NIGHT</Text>
        </Paragraph>
        <Paragraph Type="Action">
            <Text>Sarah and Mark enter together. She turns to face him.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>SARAH</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>I am surprised. You have really changed for the better.</Text>
        </Paragraph>
        <Paragraph Type="Character">
            <Text>MARK</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
            <Text>You gave me a reason to change. Thank you for believing in us.</Text>
        </Paragraph>
    </Content>
</FinalDraft>
